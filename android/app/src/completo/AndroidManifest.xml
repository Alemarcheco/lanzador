<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solo en la versión "completa": Play Protect bloquea apps instaladas fuera de
         Play Store que piden acceso a las notificaciones. -->
    <application>
        <!-- Puntos de notificación junto al nombre de las apps -->
        <service
            android:name=".Notificaciones"
            android:label="Lanzador: puntos de notificación"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Apagar la pantalla con doble toque sin perder la huella -->
        <service
            android:name=".ServicioBloqueo"
            android:label="Lanzador: apagar pantalla con doble toque"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accesibilidad_bloqueo" />
        </service>
    </application>
</manifest>
