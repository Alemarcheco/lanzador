<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solo en la versión "completa": Play Protect bloquea apps instaladas fuera de
         Play Store que piden acceso a las notificaciones. -->
    <application>
        <!-- Puntos de notificación junto al nombre de las apps -->
        <service
            android:name=".Notificaciones"
            android:label="Lanzador: puntos de notificación"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
